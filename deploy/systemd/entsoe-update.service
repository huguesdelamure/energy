[Unit]
Description=Collecte ENTSO-E : derniers jours de tous les jeux
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=energy
Group=energy
ExecStart=/opt/energy/venv/bin/python -I /opt/energy/collector/entsoe_collect.py update --days 3
Nice=10
TimeoutStartSec=50min
