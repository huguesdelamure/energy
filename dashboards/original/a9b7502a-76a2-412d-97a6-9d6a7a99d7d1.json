egend":{"calcs":["min","max"],"displayMode":"table","placement":"bottom","showLegend":true,"sortBy":"Mean","sortDesc":true},"timezone":["utc"],"tooltip":{"mode":"multi","sort":"none"}},"targets":[{"datasource":{"type":"postgres","uid":"000000001"},"editorMode":"code","format":"time_series","hide":false,"rawQuery":true,"rawSql":"select * from entsoe.capture_price(\r\n  ARRAY[$zones]::text[],\r\n\tARRAY[$production_types]::production_type[],\r\n\tARRAY[$others]::text[],\r\n\tARRAY[$production_types_day_ahead]::production_type[],\r\n\t$__timeFrom(),\r\n\t$__timeTo(),\r\n\t'$bucket_width')","refId":"B","sql":{"columns":[{"parameters":[],"type":"function"}],"groupBy":[{"property":{"type":"string"},"type":"groupBy"}],"limit":50}}],"title":"Capture price per countries and per production types - energygraph.info","transformations":[{"id":"filterFieldsByName","options":{"include":{"pattern":"Time|price.*"}}}],"type":"timeseries"},{"datasource":{"type":"datasource","uid":"-- Dashboard --"},"fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"axisCenteredZero":false,"axisColorMode":"text","axisLabel":"","axisPlacement":"auto","barAlignment":0,"drawStyle":"line","fillOpacity":0,"gradientMode":"none","hideFrom":{"legend":false,"tooltip":false,"viz":false},"lineInterpolation":"smooth","lineWidth":1,"pointSize":5,"scaleDistribution":{"type":"linear"},"showPoints":"auto","spanNulls":true,"stacking":{"group":"A","mode":"none"},"thresholdsStyle":{"mode":"dashed"}},"mappings":[],"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]},"unit":"percentunit"},"overrides":[]},"gridPos":{"h":26,"w":12,"x":12,"y":0},"id":5,"options":{"legend":{"calcs":["min","max"],"displayMode":"table","placement":"bottom","showLegend":true,"sortBy":"Mean","sortDesc":true},"timezone":["utc"],"tooltip":{"mode":"multi","sort":"none"}},"targets":[{"datasource":{"type":"datasource","uid":"-- Dashboard --"},"panelId":2,"refId":"A"}],"title":"Capture rate per countries and per production types - energygraph.info","transformations":[{"id":"filterFieldsByName","options":{"include":{"pattern":"Time|rate.*"}}}],"type":"timeseries"},{"datasource":{"type":"postgres","uid":"I3yziRGVz"},"gridPos":{"h":8,"w":24,"x":0,"y":26},"id":4,"options":{"content":"{{translate \"Main\"}}\r\n\r\n\r\nSource : [ENTSO-E](https://transparency.entsoe.eu)","defaultContent":"{{translate \"Main\"}}\r\n\r\n\r\nSource : [ENTSO-E](https://transparency.entsoe.eu)","editor":{"format":"auto","height":200,"language":"markdown"},"editors":[],"everyRow":true,"helpers":"const messages = {\r\n  \"Main\": {\r\n    'en': `These graphs show the capture price of different types of generation on the day-ahead market in the zone under consideration.\r\nThe price of electricity cannot be reduced to the day-ahead price. There are many markets with different timeframes, different auction or trading systems, subsidies or purchase obligations, all of which contribute to the formation of the price of electricity.\r\nReducing the price of electricity to a day-ahead price or a certain forward price would be a mistake or misinformation.\r\nThis capture price is calculated as the weighted average of the hourly day-ahead prices by the hourly production considered.\r\nIn the base case, it is a constant value and therefore corresponds to the day-ahead price, for demand it is weighted by hourly demand, and for day-ahead solar and wind it is weighted by estimated day-ahead production.\r\n\r\nSelect one or more zones in the first selector, then different profile types in the following selectors: production types, other (base or demand), and solar or wind according to estimated day-ahead production.  \r\nSelect a time interval value in the last selector to display capture prices averaged over this time interval.`,\r\n    'fr': `Ces graph affichent le prix de capture des différents types de production sur le marché day ahead dans la zone considérée.\r\nLe prix de l'électricité ne se résume pas au prix day ahead, il existe de multiples marchés à temporalités différentes, système d'enchères ou d'échange différents, subventions ou obligations d'achat contribuant à la formation du prix de l'électricité.\r\nRésumer le prix de l'électricité à un prix day ahead ou un certain prix à terme serait une erreur ou de la désinformation.\r\nCe prix de capture est calculé comme la moyenne pondérée des prix horaires day ahead par la production horaire considérée.\r\nDans le cas de base c'est une valeur constante donc correspondant au prix day ahead, pour demand c'est pondéré par la demande horaire, et pour solaire et éolien day ahead c'est pondéré par la production estimée day ahead.\r\n\r\nSélectionnez une ou plusieurs zone dans le premier sélecteur, puis différents types de profils dans les sélecteurs suivant : types de production, autre (base ou demande), et solaire ou éolien selon la production estimé day ahead.  \r\nSélectionnez une valeur d'interval de temps dans le dernier sélecteur pour afficher les prix de capture moyennés sur cet interval de temps.`\r\n  }\r\n}\r\n\r\nhandlebars.registerHelper('translate',\r\n  (message) =\u003e messages[message][navigator.language] ?? messages[message]['en']);","styles":""},"pluginVersion":"9.5.1","title":"Help","type":"marcusolsson-dynamictext-panel"}],"refresh":"","revision":1,"schemaVersion":38,"style":"dark","tags":[],"templating":{"list":[{"current":{"selected":true,"text":["ES"],"value":["ES"]},"hide":0,"includeAll":false,"label":"Zones","multi":true,"name":"zones","options":[{"selected":false,"text":"AT","value":"AT"},{"selected":false,"text":"BE","value":"BE"},{"selected":false,"text":"BG","value":"BG"},{"selected":false,"text":"CH","value":"CH"},{"selected":false,"text":"CZ","value":"CZ"},{"selected":false,"text":"DE_LU","value":"DE_LU"},{"selected":false,"text":"DK1","value":"DK1"},{"selected":false,"text":"DK2","value":"DK2"},{"selected":false,"text":"EE","value":"EE"},{"selected":true,"text":"ES"